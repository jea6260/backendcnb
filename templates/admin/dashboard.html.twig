{% extends 'base.html.twig' %}

{% block title %}CNB Operaciones{% endblock %}

{% block body %}
    <header class="mb-4 d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
            <h1 class="h3 mb-1">Panel operativo</h1>
            <p class="text-muted mb-0">Gestión de socios, varadero, tareas, marineros y activos del club.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-primary" href="{{ path('admin_nivel_lago') }}">Nivel del lago</a>
            <a class="btn btn-primary" href="{{ path('admin_varadero') }}">Planificador de varadero</a>
        </div>
    </header>

    {% if app.session.get('cnb_rol') == 'admin' %}
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h5">Alta de personal</h2>
                <p class="text-muted">No usa número de socio. Entra por el formulario de personal y tiene que cambiar la clave.</p>
                <form method="post" action="{{ path('admin_personal') }}" class="row g-2 align-items-end">
                    <div class="col-12 col-md-5">
                        <label class="form-label" for="personal-email">Mail</label>
                        <input class="form-control" id="personal-email" name="email" type="email" required>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label" for="personal-password">Clave inicial</label>
                        <input class="form-control" id="personal-password" name="password" type="text" minlength="8" required>
                    </div>
                    <div class="col-12 col-md-3">
                        <button class="btn btn-primary w-100" type="submit">Crear personal</button>
                    </div>
                </form>
            </div>
        </div>
    {% endif %}

    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h2 class="h5 mb-1">Nivel del lago</h2>
                <p class="text-muted mb-0">Grafico de msnm · ultima semana, mes o año.</p>
            </div>
            <a class="btn btn-primary" href="{{ path('admin_nivel_lago') }}">Abrir grafico</a>
        </div>
    </div>

    <div class="row g-3">
        {% for name, resource in resources %}
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between gap-3">
                            <div>
                                <h2 class="h5">{{ resource.label }}</h2>
                                <p class="text-muted">{{ resource.description }}</p>
                            </div>
                            <span class="badge text-bg-secondary align-self-start">{{ stats[name] }}</span>
                        </div>
                        <a class="btn btn-primary" href="{{ path('admin_resource_index', {resource: name}) }}">Abrir</a>
                        {% if name == 'reservas-varadero' %}
                            <a class="btn btn-outline-primary" href="{{ path('admin_varadero') }}">Planificar</a>
                        {% else %}
                            <a class="btn btn-outline-primary" href="{{ path('admin_resource_new', {resource: name}) }}">Nuevo</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
