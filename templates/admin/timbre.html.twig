{% extends 'base.html.twig' %}

{% block title %}Timbre · CNB{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <img src="/images/cnb_logo.jpeg" alt="Club Náutico Bariloche" width="72" height="72">
                    <h1 class="h4 mt-3">Timbre</h1>
                    <p class="text-muted">{% if nombre %}{{ nombre }} · {% endif %}socio {{ numero }}</p>
                    {% if aviso == 'enviado' %}
                        <div class="alert alert-success">Pedido enviado. El timbre suena en la sede en unos segundos.</div>
                    {% elseif aviso == 'espera' %}
                        <div class="alert alert-warning">Ya hay un timbre en camino.</div>
                    {% elseif aviso == 'error' %}
                        <div class="alert alert-danger">No se pudo enviar el pedido.</div>
                    {% endif %}
                    <p class="text-muted" id="espera">{% if esperando %}Esperando el registro del timbre en la sede.{% endif %}</p>
                    <form method="post">
                        <button class="btn btn-primary btn-lg w-100" type="submit" {% if esperando %}disabled{% endif %}>Timbre</button>
                    </form>
                    {% if esperando %}
                        <script>
                            const timer = setInterval(async () => {
                                const res = await fetch('{{ path('admin_timbre_estado') }}');
                                const data = await res.json();
                                if (data.logged) {
                                    clearInterval(timer);
                                    location.href = '{{ path('admin_dashboard') }}';
                                }
                            }, 2000);
                        </script>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
