{% extends 'base.html.twig' %}

{% block title %}Ingreso · Club Náutico Bariloche{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <h1 class="h3 mb-3">Ingreso al panel</h1>
            {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endif %}
            <div class="card shadow-sm">
                <div class="card-body d-grid gap-3">
                    {% if cambiar_pin %}
                        <p class="mb-0">El PIN 1234 es el de fábrica. Cambialo para entrar. Socio #{{ numero }}.</p>
                        <form method="post" action="{{ path('admin_login') }}" class="d-grid gap-3">
                            <input type="hidden" name="_token" value="{{ token }}">
                            <input type="hidden" name="accion" value="cambiar_pin">
                            <div>
                                <label class="form-label" for="nuevo">PIN nuevo</label>
                                <input class="form-control" id="nuevo" name="nuevo" type="password" inputmode="numeric" pattern="[0-9]{1,6}" maxlength="6" autocomplete="new-password" required>
                            </div>
                            <div>
                                <label class="form-label" for="confirmar">Repetir PIN</label>
                                <input class="form-control" id="confirmar" name="confirmar" type="password" inputmode="numeric" pattern="[0-9]{1,6}" maxlength="6" autocomplete="new-password" required>
                            </div>
                            <button class="btn btn-primary" type="submit">Guardar PIN y entrar</button>
                        </form>
                    {% else %}
                        <p class="text-muted mb-0">Si sos socio, la primera vez entrá con tu número y el PIN del timbre. Si el PIN es 1234, te pedimos cambiarlo. Si no sos socio, pedile acceso al administrador.</p>
                        <form method="post" action="{{ path('admin_login') }}" class="d-grid gap-3">
                            <input type="hidden" name="_token" value="{{ token }}">
                            <div>
                                <label class="form-label" for="username">Usuario</label>
                                <input class="form-control" id="username" name="username" type="text" autocomplete="username" required value="{{ username }}">
                            </div>
                            <div>
                                <label class="form-label" for="password">Contraseña</label>
                                <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required>
                            </div>
                            <button class="btn btn-primary" type="submit">Entrar</button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
