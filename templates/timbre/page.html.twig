<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0A1E46">
    <meta name="robots" content="noindex">
    <title>
        {% if mode == 'pin' %}Cambiar PIN · CNB
        {% elseif mode == 'timbre' %}Timbre · CNB
        {% else %}Acceso · CNB{% endif %}
    </title>
    <link rel="icon" href="/images/cnb_logo-32.jpg">
    <style>
        body{font-family:system-ui,-apple-system,Segoe UI,sans-serif;background:#e8eef5;text-align:center;padding:32px 16px;margin:0;color:#0A1E46}
        .box{background:#fff;max-width:400px;margin:auto;padding:28px 24px;border-radius:12px;box-shadow:0 2px 14px rgba(10,30,70,.12)}
        .brand img{width:72px;height:72px;object-fit:contain}
        .brand h1{font-size:1.2rem;margin:10px 0 4px;color:#0A1E46;letter-spacing:.02em}
        .sub{color:#5a6a80;font-size:.9rem;margin:0 0 18px}
        label{display:block;text-align:left;color:#5a6a80;font-size:.85rem;margin-top:6px}
        input{width:100%;padding:12px;margin:6px 0 10px;box-sizing:border-box;border:1px solid #c5d0e0;border-radius:8px;font-size:16px}
        button{width:100%;padding:14px;margin:8px 0;background:#0A1E46;color:#fff;border:0;border-radius:8px;font-size:17px;font-weight:600;cursor:pointer}
        button:active{background:#123A7A}
        button:disabled{background:#a0aec0}
        .logout{background:transparent;color:#5a6a80;font-size:.9rem;font-weight:500;padding:8px}
        .warn{background:#fff8e6;border:1px solid #e6c35c;padding:12px;border-radius:8px;margin:16px 0;color:#6b5300}
        .ok{background:#eef6ee;border:1px solid #9cba9c;padding:12px;border-radius:8px;margin:16px 0;color:#1b4d1b}
        .err{color:#b71c1c;margin:10px 0}
        .meta{font-size:12px;color:#8a97a8;margin:8px 0 0}
    </style>
</head>
<body>
<div class="box">
    <div class="brand">
        <img src="/images/cnb_logo.jpeg" alt="Club Náutico Bariloche" width="72" height="72">
        {% if mode == 'pin' %}
            <h1>Cambiar PIN</h1>
            <p class="sub">Club Náutico Bariloche</p>
        {% elseif mode == 'timbre' %}
            <h1>Timbre</h1>
            <p class="sub">{{ nombre ?: 'Club Náutico Bariloche' }}</p>
        {% else %}
            <h1>Club Náutico Bariloche</h1>
            <p class="sub">Acceso de socios</p>
        {% endif %}
    </div>

    {% if mode == 'login' %}
        {% if ok is defined and ok %}
            <div class="ok">{{ ok }}</div>
        {% endif %}
        {% if error is defined and error %}
            <p class="err">{{ error }}</p>
        {% endif %}
        <form method="post" action="{{ path('timbre_login') }}">
            <input type="hidden" name="_token" value="{{ token }}">
            <label>Número de socio</label>
            <input name="numeroSocio" required autofocus inputmode="numeric">
            <label>PIN (hasta 6 dígitos)</label>
            <input name="pin" type="password" pattern="[0-9]{1,6}" maxlength="6" required inputmode="numeric">
            <button type="submit">Ingresar</button>
        </form>
    {% elseif mode == 'pin' %}
        {% if obligatorio is defined and obligatorio %}
            <div class="warn"><strong>PIN por defecto (1234)</strong><br>Debés cambiarlo antes de continuar.</div>
        {% endif %}
        {% if error is defined and error %}
            <p class="err">{{ error }}</p>
        {% endif %}
        <form method="post" action="{{ path('timbre_pin') }}">
            <input type="hidden" name="_token" value="{{ token }}">
            <label>Nuevo PIN (hasta 6 dígitos)</label>
            <input name="nuevoPin" type="password" pattern="[0-9]{1,6}" maxlength="6" required autofocus inputmode="numeric">
            <label>Confirmar nuevo PIN</label>
            <input name="confirmarPin" type="password" pattern="[0-9]{1,6}" maxlength="6" required inputmode="numeric">
            <button type="submit">Guardar PIN</button>
        </form>
    {% else %}
        {% if aviso == 'enviado' %}
            <div class="ok">Pedido enviado. El timbre suena en la sede en unos segundos.</div>
        {% elseif aviso == 'espera' %}
            <div class="warn">Ya hay un timbre en camino. Esperá a que suene.</div>
        {% elseif aviso == 'error' or aviso == 'sesion' %}
            <p class="err">No se pudo enviar el pedido. Volvé a intentar.</p>
        {% endif %}
        <form method="post" action="{{ path('timbre_tocar') }}">
            <input type="hidden" name="_token" value="{{ token }}">
            <button type="submit" id="timbre">Timbre</button>
        </form>
        <p class="meta" id="espera">{% if esperando is defined and esperando %}Esperando el registro del timbre en la sede.{% else %}Se anota en la cola y el equipo de la sede lo toma dentro de 15 segundos.{% endif %}</p>
        {% if esperando is defined and esperando %}
            <script>
                const espera = document.getElementById('espera');
                const timer = setInterval(async () => {
                    const res = await fetch('{{ path('timbre_estado') }}');
                    const data = await res.json();
                    if (data.logged) {
                        clearInterval(timer);
                        location.href = '{{ path('timbre_home', {listo: 1}) }}';
                    }
                }, 2000);
                setTimeout(() => {
                    clearInterval(timer);
                    if (espera) espera.textContent = 'Todavía no está el registro. Podés salir y volver a intentar.';
                }, 90000);
            </script>
        {% endif %}
        <form method="post" action="{{ path('timbre_salir') }}">
            <button class="logout" type="submit">Salir</button>
        </form>
    {% endif %}
</div>
</body>
</html>
