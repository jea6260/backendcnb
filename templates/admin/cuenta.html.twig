{% extends 'base.html.twig' %}

{% block title %}Mi cuenta · CNB{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <h1 class="h3 mb-3">Mi cuenta</h1>
            <p class="text-muted">
                {% if rol == 'socio' %}Cuenta de socio.{% else %}Cuenta de personal del club.{% endif %}
                Cambiá el mail y la contraseña. Hace falta la contraseña actual.
            </p>
            {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endif %}
            <form method="post" class="card shadow-sm">
                <div class="card-body d-grid gap-3">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <div>
                        <label class="form-label" for="email">Mail</label>
                        <input class="form-control" id="email" name="email" type="email" required value="{{ email }}">
                    </div>
                    <div>
                        <label class="form-label" for="actual">Contraseña actual</label>
                        <input class="form-control" id="actual" name="actual" type="password" required>
                    </div>
                    <div>
                        <label class="form-label" for="password">Contraseña nueva (vacío la deja igual)</label>
                        <input class="form-control" id="password" name="password" type="password" minlength="8">
                    </div>
                    <button class="btn btn-primary" type="submit">Guardar</button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
