{% set layout %}{% block layout %}app{% endblock %}{% endset %}
{% set modo = layout|trim %}
{% set logged = app.session.get('cnb_admin_username') %}
{% set perfil = app.session.get('cnb_perfil') %}
{% set en_panel = logged and modo == 'app' %}
{% set ruta = app.request.pathInfo %}
{% set apps = {
    'superuser': 'Administración',
    'administrador': 'Administración',
    'operador': 'Operaciones',
    'marinero': 'Marineros',
    'socio': 'Socios'
} %}
<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Club Náutico Bariloche{% endblock %}</title>
        <link rel="icon" type="image/jpeg" href="/images/cnb_logo.jpeg">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="/css/cnb.css" rel="stylesheet">
        {% block stylesheets %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body class="{{ en_panel ? 'cnb-app' : 'cnb-guest' }}">
        {% if en_panel %}
            <div class="cnb-shell" id="cnb-shell">
                <aside class="cnb-menu" id="cnb-menu">
                    <form method="post" action="{{ path('admin_logout') }}" class="cnb-menu-salir">
                        <button class="cnb-menu-link" type="submit">Salir</button>
                    </form>
                    <nav class="cnb-menu-nav">
                        {% include 'admin/_menu.html.twig' with {perfil: perfil, ruta: ruta} %}
                    </nav>
                </aside>
                <div class="cnb-main">
                    <header class="cnb-top">
                        <button class="cnb-menu-toggle" id="cnb-menu-toggle" type="button" aria-label="Mostrar u ocultar el menú" aria-controls="cnb-menu">
                            <span></span>
                            <span></span>
                            <span></span>
                        </button>
                        <a class="cnb-brand" href="{{ path('admin_dashboard') }}">
                            <img class="cnb-brand-logo" src="/images/cnb_logo.jpeg" alt="Club Náutico Bariloche" width="51" height="72">
                            <span>
                                <span class="cnb-brand-title">Club Náutico Bariloche</span>
                                <span class="cnb-brand-sub">{{ apps[perfil]|default('Club') }}</span>
                            </span>
                        </a>
                        <div class="cnb-user">
                            <a class="cnb-profile" href="{{ path('admin_cuenta') }}">
                                <span class="cnb-profile-icon" aria-hidden="true">
                                    {% if perfil == 'socio' %}
                                        <img class="cnb-profile-photo" src="{{ path('admin_perfil_foto') }}" alt="" width="42" height="42" onerror="this.remove()">
                                    {% endif %}
                                    <svg viewBox="0 0 24 24" width="28" height="28">
                                        <circle cx="12" cy="8" r="3.2" fill="none" stroke="currentColor" stroke-width="1.8"/>
                                        <path d="M5 19.2c1.4-3 3.8-4.5 7-4.5s5.6 1.5 7 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                                    </svg>
                                </span>
                                <span class="cnb-profile-name">{{ app.session.get('cnb_socio_nombre') }}</span>
                            </a>
                            <form method="post" action="{{ path('admin_logout') }}">
                                <button class="cnb-salir" type="submit">Salir</button>
                            </form>
                        </div>
                    </header>
        {% else %}
            <header class="cnb-header mb-4">
                <div class="container-fluid d-flex align-items-center gap-3">
                    {% if modo == 'nivel' %}
                        <span class="cnb-brand">
                            <img class="cnb-brand-logo" src="/images/cnb_logo.jpeg" alt="Club Náutico Bariloche" width="51" height="72">
                            <span>
                                <span class="cnb-brand-title">Club Náutico Bariloche</span>
                                <span class="cnb-brand-sub">Nivel del lago</span>
                            </span>
                        </span>
                    {% else %}
                        <a class="cnb-brand" href="{{ path(logged ? 'admin_dashboard' : 'admin_login') }}">
                            <img class="cnb-brand-logo" src="/images/cnb_logo.jpeg" alt="Club Náutico Bariloche" width="51" height="72">
                            <span>
                                <span class="cnb-brand-title">Club Náutico Bariloche</span>
                                <span class="cnb-brand-sub">ingreso</span>
                            </span>
                        </a>
                    {% endif %}
                </div>
            </header>
        {% endif %}
        <main class="{{ en_panel ? 'cnb-content' : 'container-fluid pb-5' }}">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
        {% if en_panel %}
                </div>
            </div>
            <script>
                (function () {
                    var shell = document.getElementById('cnb-shell');
                    var button = document.getElementById('cnb-menu-toggle');
                    if (!shell || !button) return;
                    if (localStorage.getItem('cnb-menu') === 'oculto') {
                        shell.classList.add('is-collapsed');
                    }
                    button.addEventListener('click', function () {
                        shell.classList.toggle('is-collapsed');
                        localStorage.setItem('cnb-menu', shell.classList.contains('is-collapsed') ? 'oculto' : 'visible');
                    });
                })();
            </script>
        {% endif %}
        {% block javascripts %}
        {% endblock %}
    </body>
</html>
