{% extends 'base.html.twig' %}

{% block title %}{{ id ? 'Editar' : 'Nuevo' }} {{ definition.singular }} - CNB{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 mb-1">{{ id ? 'Editar' : 'Nuevo' }} {{ definition.singular }}</h1>
            <p class="text-muted mb-0">{{ definition.description }}</p>
        </div>
        <a class="btn btn-outline-secondary" href="{{ path('admin_resource_index', {resource: resource}) }}">Volver</a>
    </div>

    {% if error %}
        <div class="alert alert-danger">{{ error }}</div>
    {% endif %}

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post" enctype="multipart/form-data" class="row g-3">
                {% for name, field in fields %}
                    {% set value = attribute(data, name) is defined ? attribute(data, name) : field.default|default('') %}
                    <div class="{{ field.type in ['textarea', 'image'] ? 'col-12' : 'col-12 col-md-6' }}">
                        {% if field.type == 'boolean' %}
                            <div class="form-check mt-4">
                                <input type="checkbox" class="form-check-input" id="{{ name }}" name="{{ name }}" value="1" {% if value %}checked{% endif %}>
                                <label class="form-check-label" for="{{ name }}">{{ field.label }}</label>
                            </div>
                        {% elseif field.type == 'image' %}
                            <label class="form-label" for="{{ name }}_file">{{ field.label }}</label>
                            {% if field.help is defined %}
                                <div class="form-text mb-2">{{ field.help }}</div>
                            {% endif %}
                            <div class="d-flex flex-wrap gap-3 align-items-start">
                                <div class="cnb-photo-preview border rounded bg-light d-flex align-items-center justify-content-center overflow-hidden"
                                     style="width: 140px; height: 180px;">
                                    <img
                                        id="{{ name }}_preview"
                                        src="{{ value ? (value starts with 'data:' ? value : 'data:image/jpeg;base64,' ~ value) : '' }}"
                                        alt="Foto"
                                        class="{{ value ? '' : 'd-none' }}"
                                        style="width: 100%; height: 100%; object-fit: cover;"
                                    >
                                    <span id="{{ name }}_placeholder" class="text-muted small{{ value ? ' d-none' : '' }}">Sin foto</span>
                                </div>
                                <div class="flex-grow-1">
                                    <input
                                        class="form-control"
                                        type="file"
                                        id="{{ name }}_file"
                                        name="{{ name }}_file"
                                        accept="image/jpeg,image/png,image/webp"
                                        data-cnb-image-input="{{ name }}"
                                    >
                                    <input type="hidden" id="{{ name }}" name="{{ name }}" value="{{ value }}">
                                    <div class="form-text mt-2">JPG, PNG o WEBP. Se usa en carnet virtual y reconocimiento facial.</div>
                                    <button type="button" class="btn btn-sm btn-outline-danger mt-2" data-cnb-clear-image="{{ name }}">
                                        Quitar foto
                                    </button>
                                </div>
                            </div>
                        {% else %}
                            <label class="form-label" for="{{ name }}">{{ field.label }}</label>

                            {% if field.type == 'choice' %}
                                <select class="form-select" id="{{ name }}" name="{{ name }}" {% if field.required|default(false) %}required{% endif %} {% if id and field.primary|default(false) %}disabled{% endif %}>
                                    {% for optionValue, optionLabel in field.choices %}
                                        <option value="{{ optionValue }}" {% if value == optionValue %}selected{% endif %}>{{ optionLabel }}</option>
                                    {% endfor %}
                                </select>
                            {% elseif field.type == 'relation' %}
                                <select class="form-select" id="{{ name }}" name="{{ name }}" {% if field.required|default(false) %}required{% endif %}>
                                    <option value="">Sin asignar</option>
                                    {% for option in relations[name] %}
                                        <option value="{{ option.id }}" {% if value == option.id %}selected{% endif %}>{{ option.label }}</option>
                                    {% endfor %}
                                </select>
                            {% elseif field.type == 'textarea' %}
                                <textarea class="form-control" id="{{ name }}" name="{{ name }}" rows="4" {% if field.required|default(false) %}required{% endif %}>{{ value }}</textarea>
                            {% else %}
                                {% set inputType = field.type == 'datetime' ? 'datetime-local' : (field.type in ['decimal', 'integer'] ? 'number' : field.type) %}
                                {% set inputValue = field.type == 'datetime' and value ? value|slice(0, 16) : value %}
                                <input class="form-control" id="{{ name }}" name="{{ name }}" type="{{ inputType }}" value="{{ inputValue }}" {% if field.type == 'decimal' %}step="0.01"{% endif %} {% if field.type == 'integer' %}step="1"{% endif %} {% if field.required|default(false) %}required{% endif %} {% if id and field.primary|default(false) %}readonly{% endif %}>
                            {% endif %}
                        {% endif %}
                    </div>
                {% endfor %}

                <div class="col-12 d-flex gap-2">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <a class="btn btn-outline-secondary" href="{{ path('admin_resource_index', {resource: resource}) }}">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        (function () {
            function toDataUrl(file, callback) {
                const reader = new FileReader();
                reader.onload = function () { callback(reader.result); };
                reader.readAsDataURL(file);
            }

            document.querySelectorAll('[data-cnb-image-input]').forEach(function (input) {
                const name = input.getAttribute('data-cnb-image-input');
                const hidden = document.getElementById(name);
                const preview = document.getElementById(name + '_preview');
                const placeholder = document.getElementById(name + '_placeholder');

                input.addEventListener('change', function () {
                    const file = input.files && input.files[0];
                    if (!file) return;
                    if (file.size > 4 * 1024 * 1024) {
                        alert('La imagen no debe superar 4 MB.');
                        input.value = '';
                        return;
                    }
                    toDataUrl(file, function (dataUrl) {
                        if (hidden) hidden.value = dataUrl;
                        if (preview) {
                            preview.src = dataUrl;
                            preview.classList.remove('d-none');
                        }
                        if (placeholder) placeholder.classList.add('d-none');
                    });
                });
            });

            document.querySelectorAll('[data-cnb-clear-image]').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    const name = btn.getAttribute('data-cnb-clear-image');
                    const hidden = document.getElementById(name);
                    const preview = document.getElementById(name + '_preview');
                    const placeholder = document.getElementById(name + '_placeholder');
                    const file = document.getElementById(name + '_file');
                    if (hidden) hidden.value = '';
                    if (file) file.value = '';
                    if (preview) {
                        preview.src = '';
                        preview.classList.add('d-none');
                    }
                    if (placeholder) placeholder.classList.remove('d-none');
                });
            });
        })();
    </script>
{% endblock %}
