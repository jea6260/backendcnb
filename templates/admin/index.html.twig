{% extends 'base.html.twig' %}

{% block title %}{{ definition.label }} - CNB{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h1 class="h3 mb-1">{{ definition.label }}</h1>
            <p class="text-muted mb-0">{{ definition.description }}</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('admin_dashboard') }}">Volver</a>
            {% if resource == 'reservas-varadero' %}
                <a class="btn btn-primary" href="{{ path('admin_varadero') }}">Planificador</a>
            {% elseif puede_crear %}
                <a class="btn btn-primary" href="{{ path('admin_resource_new', {resource: resource}) }}">Nuevo</a>
            {% endif %}
        </div>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <h2 class="h6 mb-3">Filtros</h2>
            <form method="get" action="{{ path('admin_resource_index', {resource: resource}) }}">
                <input type="hidden" name="sort" value="{{ sort }}">
                <input type="hidden" name="dir" value="{{ dir }}">
                {% if vista %}
                    <input type="hidden" name="vista" value="{{ vista }}">
                {% endif %}
                <div class="row g-2 align-items-end">
                    {% for name, field in fields %}
                        {% if field.type != 'image' %}
                            <div class="col-12 col-md-4 col-xl-3">
                                <label class="form-label small mb-1" for="filtro-{{ name }}">{{ field.label }}</label>
                                {% if field.type == 'choice' %}
                                    <select class="form-select form-select-sm" id="filtro-{{ name }}" name="f[{{ name }}]">
                                        {% if definition.list_scope.column|default('') == name %}
                                            <option value="__operativos" {{ filters[name]|default('__operativos') == '__operativos' ? 'selected' : '' }}>Sin baja, menor ni ausente</option>
                                            <option value="__todos" {{ filters[name]|default('') == '__todos' ? 'selected' : '' }}>Todos</option>
                                        {% else %}
                                            <option value="">Todos</option>
                                        {% endif %}
                                        {% for code, label in field.choices %}
                                            <option value="{{ code }}" {{ filters[name]|default('') == code ? 'selected' : '' }}>{{ label }}</option>
                                        {% endfor %}
                                    </select>
                                {% elseif field.type == 'boolean' %}
                                    <select class="form-select form-select-sm" id="filtro-{{ name }}" name="f[{{ name }}]">
                                        <option value="">Todos</option>
                                        <option value="si" {{ filters[name]|default('') == 'si' ? 'selected' : '' }}>Sí</option>
                                        <option value="no" {{ filters[name]|default('') == 'no' ? 'selected' : '' }}>No</option>
                                    </select>
                                {% else %}
                                    <input
                                        class="form-control form-control-sm"
                                        id="filtro-{{ name }}"
                                        type="search"
                                        name="f[{{ name }}]"
                                        value="{{ filters[name]|default('') }}"
                                        placeholder="Contiene…"
                                    >
                                {% endif %}
                            </div>
                        {% endif %}
                    {% endfor %}
                    {% if definition.list_scope.via is defined %}
                        <div class="col-12 col-md-4 col-xl-3">
                            <label class="form-label small mb-1" for="filtro-socio-estado">Estado del socio</label>
                            <select class="form-select form-select-sm" id="filtro-socio-estado" name="f[socio_estado]">
                                <option value="__operativos" {{ filters.socio_estado|default('__operativos') == '__operativos' ? 'selected' : '' }}>Sin baja, menor ni ausente</option>
                                <option value="__todos" {{ filters.socio_estado|default('') == '__todos' ? 'selected' : '' }}>Todos</option>
                                {% for code, label in definition.list_scope.choices %}
                                    <option value="{{ code }}" {{ filters.socio_estado|default('') == code ? 'selected' : '' }}>{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    {% endif %}
                    <div class="col-12 col-md-auto d-flex gap-2">
                        <button class="btn btn-sm btn-primary" type="submit">Buscar</button>
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_resource_index', {resource: resource, vista: vista ?: null}) }}">Limpiar</a>
                    </div>
                </div>
                {% if definition.list_scope is defined %}
                    <p class="form-text mb-0 mt-2">Al entrar no se listan baja, menor ni ausente. Los filtros se combinan.</p>
                {% else %}
                    <p class="form-text mb-0 mt-2">Los filtros se combinan.</p>
                {% endif %}
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 cnb-list-table">
                <thead class="table-light">
                    <tr>
                        {% if show_id %}
                            <th>
                                <a class="cnb-sort-link" href="{{ path('admin_resource_index', {resource: resource, sort: 'id', dir: sort == 'id' and dir == 'asc' ? 'desc' : 'asc', f: filters}) }}">
                                    ID
                                    {% if sort == 'id' %}
                                        <span class="cnb-sort-indicator">{{ dir == 'asc' ? '▲' : '▼' }}</span>
                                    {% endif %}
                                </a>
                            </th>
                        {% endif %}
                        {% for name, field in fields %}
                            <th>
                                <a class="cnb-sort-link" href="{{ path('admin_resource_index', {resource: resource, sort: name, dir: sort == name and dir == 'asc' ? 'desc' : 'asc', f: filters}) }}">
                                    {{ field.label }}
                                    {% if sort == name %}
                                        <span class="cnb-sort-indicator">{{ dir == 'asc' ? '▲' : '▼' }}</span>
                                    {% endif %}
                                </a>
                            </th>
                        {% endfor %}
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        <tr>
                            {% if show_id %}
                                <td class="text-muted">#{{ row.id }}</td>
                            {% endif %}
                            {% for name, field in fields %}
                                {% set value = attribute(row, name)|default('') %}
                                <td>
                                    {% if field.type == 'boolean' %}
                                        {{ value ? 'Si' : 'No' }}
                                    {% elseif field.type == 'image' %}
                                        {% if value %}
                                            <img
                                                src="{{ value starts with 'data:' ? value : 'data:image/jpeg;base64,' ~ value }}"
                                                alt="Foto"
                                                class="rounded border"
                                                style="width: 48px; height: 64px; object-fit: cover;"
                                            >
                                        {% else %}
                                            <span class="text-muted">Sin foto</span>
                                        {% endif %}
                                    {% elseif field.type == 'relation' %}
                                        {{ attribute(row, name ~ '_label')|default(value) }}
                                    {% elseif field.type == 'choice' and field.choices[value] is defined %}
                                        {% if name == 'estado' %}
                                            <span class="cnb-estado cnb-estado-{{ value }}">{{ field.choices[value] }}</span>
                                        {% else %}
                                            {{ field.choices[value] }}
                                        {% endif %}
                                    {% else %}
                                        {{ value }}
                                    {% endif %}
                                </td>
                            {% endfor %}
                            <td class="text-end">
                                {% if puede_editar %}
                                    <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_resource_edit', {resource: resource, id: attribute(row, primary_key)}) }}">Editar</a>
                                {% endif %}
                                {% if puede_borrar %}
                                    <form method="post" action="{{ path('admin_resource_delete', {resource: resource, id: attribute(row, primary_key)}) }}" class="d-inline" onsubmit="return confirm('Eliminar registro?');">
                                        <button class="btn btn-sm btn-outline-danger" type="submit">Eliminar</button>
                                    </form>
                                {% endif %}
                                {% if not puede_editar and not puede_borrar %}
                                    <span class="text-muted small">Solo lectura</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="{{ fields|length + (show_id ? 2 : 1) }}" class="text-center text-muted py-4">No hay registros que coincidan con la busqueda.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    {% if rows is not empty %}
        <p class="text-muted small mt-2 mb-0">Mostrando hasta 500 registros. Haga clic en el nombre de una columna para ordenar.</p>
    {% endif %}
{% endblock %}
