{% extends 'base.html.twig' %}

{% block title %}Mi cuenta · CNB{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <h1 class="h3 mb-1">Mi cuenta</h1>
            {% if rol == 'socio' %}
                <img class="cnb-perfil-foto mb-3" src="{{ path('admin_perfil_foto') }}" alt="Foto de perfil" width="96" height="128" onerror="this.remove()">
            {% endif %}
            {% if rol == 'socio' and nombre %}
                <p class="h5 mb-1">{{ nombre }}</p>
            {% endif %}
            {% if rol == 'socio' and numero %}
                <p class="text-muted mb-2">Socio {{ numero }}</p>
            {% endif %}
            <p class="text-muted">
                {% if rol == 'socio' %}
                    Tu ingreso al panel es el mail y la contraseña. Acá cambiás el PIN del timbre. El PIN 1234 no se puede volver a usar.
                {% else %}
                    Cuenta de personal del club. Cambiá el mail y la contraseña. Hace falta la contraseña actual.
                {% endif %}
            </p>
            {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endif %}
            <form method="post" class="card shadow-sm">
                <div class="card-body d-grid gap-3">
                    <input type="hidden" name="_token" value="{{ token }}">
                    {% if rol == 'socio' %}
                        <div>
                            <label class="form-label" for="actual">PIN actual</label>
                            <input class="form-control" id="actual" name="actual" type="password" inputmode="numeric" pattern="[0-9]{1,6}" maxlength="6" required>
                        </div>
                        <div>
                            <label class="form-label" for="nuevo">PIN nuevo</label>
                            <input class="form-control" id="nuevo" name="nuevo" type="password" inputmode="numeric" pattern="[0-9]{1,6}" maxlength="6" required>
                        </div>
                        <div>
                            <label class="form-label" for="confirmar">Repetir PIN</label>
                            <input class="form-control" id="confirmar" name="confirmar" type="password" inputmode="numeric" pattern="[0-9]{1,6}" maxlength="6" required>
                        </div>
                    {% else %}
                        <div>
                            <label class="form-label" for="email">Mail</label>
                            <input class="form-control" id="email" name="email" type="email" required value="{{ email }}">
                        </div>
                        <div>
                            <label class="form-label" for="actual">Contraseña actual</label>
                            <input class="form-control" id="actual" name="actual" type="password" required>
                        </div>
                        <div>
                            <label class="form-label" for="password">Contraseña nueva (vacío la deja igual)</label>
                            <input class="form-control" id="password" name="password" type="password" minlength="8">
                        </div>
                    {% endif %}
                    <button class="btn btn-primary" type="submit">Guardar</button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
