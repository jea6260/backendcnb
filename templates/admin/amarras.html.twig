{% extends 'base.html.twig' %}

{% block title %}Amarras · CNB{% endblock %}

{% block body %}
    <header class="mb-4">
        <h1 class="h3 mb-1">Solicitudes de amarra</h1>
        <p class="text-muted mb-0">
            {% if socio and nombre %}{{ nombre }} · socio {{ numero }}. {% endif %}
            Alquiler o compra, en agua o tierra, y también ampliación.
            Hasta {{ pies }} pies puede ir a tierra. Una eslora mayor va a agua.
            La ampliación usa una embarcación del padrón y muestra los metros ya comprados.
            Puede ser solo más metros, o la compra o el cambio de esa embarcación por un tipo nuevo.
            La prioridad sale de los m2 disponibles y de la fecha de ingreso del socio.
        </p>
    </header>
    {% if error %}
        <div class="alert alert-danger">{{ error }}</div>
    {% endif %}

    {% if socio %}
        <form method="post" class="card shadow-sm mb-4">
            <div class="card-body row g-3">
                <input type="hidden" name="accion" value="solicitar">
                <div class="col-6 col-md-3">
                    <label class="form-label" for="modalidad">Modalidad</label>
                    <select class="form-select" id="modalidad" name="modalidad" required>
                        <option value="alquiler">Alquiler</option>
                        <option value="compra">Compra</option>
                        <option value="ampliacion">Ampliación</option>
                    </select>
                </div>
                <div class="col-12" id="ampliacion-panel" hidden>
                    {% if barcos is empty %}
                        <div class="alert alert-warning mb-0">No hay embarcaciones a tu nombre. La ampliación necesita una del padrón.</div>
                    {% else %}
                        <p class="mb-2">Embarcaciones y metros de amarra comprados</p>
                        <div class="list-group mb-3">
                            {% for barco in barcos %}
                                <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" data-barco="{{ barco.id }}">
                                    <span>{{ barco.nombre }}{% if barco.modelo %} · {{ barco.modelo }}{% endif %}{% if barco.eslora_m %} · eslora {{ barco.eslora_m }} m{% endif %}</span>
                                    <strong>{{ barco.metros_comprados is not null ? barco.metros_comprados ~ ' m comprados' : 'Sin metros comprados' }}</strong>
                                </button>
                            {% endfor %}
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" value="1" id="cambio-embarcacion" name="cambio_embarcacion">
                            <label class="form-check-label" for="cambio-embarcacion">Compra o cambio de la embarcación actual</label>
                        </div>
                        <p class="small text-muted mb-0">Si la marcás, el pedido reemplaza esa embarcación por el tipo nuevo.</p>
                    {% endif %}
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label" for="embarcacion">Embarcación</label>
                    <select class="form-select" id="embarcacion" name="embarcacion_id">
                        <option value="">Todavía no está en el padrón</option>
                        {% for barco in barcos %}
                            <option value="{{ barco.id }}" data-eslora="{{ barco.eslora_m }}">{{ barco.nombre }}{% if barco.modelo %} · {{ barco.modelo }}{% endif %}{% if barco.metros_comprados is not null %} · {{ barco.metros_comprados }} m comprados{% endif %}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label" for="tipo" id="tipo-label">Tipo, si la embarcación no tiene ficha</label>
                    <select class="form-select" id="tipo" name="tipo_id">
                        <option value="">Usar el tipo de la embarcación</option>
                        {% for tipo in tipos %}
                            <option value="{{ tipo.id }}" data-eslora="{{ tipo.eslora_max_m ?? tipo.eslora_m }}">{{ tipo.nombre }}{% if tipo.eslora_m %} · {{ tipo.eslora_m }} m{% endif %}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label" for="destino">Destino solicitado</label>
                    <select class="form-select" id="destino" name="destino" required>
                        <option value="tierra">Tierra</option>
                        <option value="agua">Agua</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label" for="obs">Notas</label>
                    <input class="form-control" id="obs" name="observaciones">
                </div>
                <div class="col-12">
                    <button class="btn btn-primary" type="submit" id="enviar-amarra">Solicitar amarra</button>
                </div>
            </div>
        </form>
        <script>
            (function () {
                var modalidad = document.getElementById('modalidad');
                var panel = document.getElementById('ampliacion-panel');
                var embarcacion = document.getElementById('embarcacion');
                var tipo = document.getElementById('tipo');
                var tipoLabel = document.getElementById('tipo-label');
                var destino = document.getElementById('destino');
                var enviar = document.getElementById('enviar-amarra');
                var cambio = document.getElementById('cambio-embarcacion');
                var pies = {{ pies }};
                var hayBarcos = {{ barcos is empty ? 'false' : 'true' }};

                function esloraDe(select) {
                    var option = select.options[select.selectedIndex];
                    if (!option) return null;
                    var raw = option.getAttribute('data-eslora');
                    if (raw === null || raw === '') return null;
                    var valor = parseFloat(raw);
                    return Number.isFinite(valor) && valor > 0 ? valor : null;
                }

                function sync() {
                    var ampliacion = modalidad.value === 'ampliacion';
                    var cambiaBarco = ampliacion && cambio && cambio.checked;
                    panel.hidden = !ampliacion;
                    tipoLabel.textContent = cambiaBarco
                        ? 'Tipo nuevo de embarcación'
                        : (ampliacion ? 'Tipo, si cambia la medida' : 'Tipo, si la embarcación no tiene ficha');
                    tipo.required = cambiaBarco;
                    embarcacion.required = ampliacion && hayBarcos;
                    enviar.disabled = ampliacion && !hayBarcos;
                    enviar.textContent = cambiaBarco
                        ? 'Pedir ampliación por cambio'
                        : (ampliacion ? 'Pedir ampliación' : 'Solicitar amarra');
                    document.querySelectorAll('[data-barco]').forEach(function (item) {
                        item.classList.toggle('active', item.getAttribute('data-barco') === embarcacion.value);
                    });
                    if (!ampliacion && cambio) cambio.checked = false;
                    var medida = esloraDe(tipo) || esloraDe(embarcacion);
                    var soloAgua = medida !== null && (medida / 0.3048) > pies;
                    var tierra = destino.querySelector('option[value="tierra"]');
                    if (tierra) tierra.disabled = soloAgua;
                    if (soloAgua) destino.value = 'agua';
                }

                modalidad.addEventListener('change', function () {
                    if (modalidad.value === 'ampliacion' && embarcacion.value === '' && embarcacion.options.length > 1) {
                        embarcacion.selectedIndex = 1;
                    }
                    sync();
                });
                embarcacion.addEventListener('change', sync);
                tipo.addEventListener('change', sync);
                if (cambio) cambio.addEventListener('change', sync);
                document.querySelectorAll('[data-barco]').forEach(function (item) {
                    item.addEventListener('click', function () {
                        embarcacion.value = item.getAttribute('data-barco');
                        sync();
                    });
                });
                sync();
            }());
        </script>
    {% endif %}

    <div class="table-responsive card shadow-sm">
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th>Prioridad</th>
                    <th>Socio</th>
                    <th>Ingreso</th>
                    <th>Solicitud</th>
                    <th>Tipo</th>
                    <th>Destino solicitado</th>
                    <th>Según eslora</th>
                    <th>Destino disponible</th>
                    <th>m2</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                {% for fila in lista %}
                    <tr>
                        <td>{{ fila.prioridad ?? '—' }}</td>
                        <td>{{ fila.socio }} · {{ fila.numero_socio }}</td>
                        <td>{{ fila.fecha_ingreso_socio }}</td>
                        <td>
                            {{ fila.fecha_solicitud }} ·
                            {{ {compra: 'Compra', alquiler: 'Alquiler', ampliacion: 'Ampliación'}[fila.modalidad]|default(fila.modalidad) }}
                            {% if fila.cambio_embarcacion %} · compra/cambio{% endif %}
                        </td>
                        <td>
                            {{ fila.tipo_nombre ?? fila.embarcacion }}
                            {% if fila.modalidad == 'ampliacion' and fila.embarcacion %}
                                <div class="small text-muted">
                                    Actual: {{ fila.embarcacion }}
                                    · {{ fila.metros_comprados is not null ? fila.metros_comprados ~ ' m comprados' : 'sin metros comprados' }}
                                    {% if fila.cambio_embarcacion %} · pasa a {{ fila.tipo_nombre }}{% endif %}
                                </div>
                            {% endif %}
                        </td>
                        <td>{{ fila.destino_solicitado }}</td>
                        <td>{{ fila.destino_por_eslora ?? 'sin medida' }}</td>
                        <td>{{ fila.destino_disponible ?? '—' }}</td>
                        <td>{{ fila.m2_necesarios ?? '—' }}{% if fila.m2_disponibles is not null %} / {{ fila.m2_disponibles }}{% endif %}</td>
                        <td>
                            {% if gestiona %}
                                <form method="post" class="d-flex gap-1">
                                    <input type="hidden" name="accion" value="actualizar">
                                    <input type="hidden" name="id" value="{{ fila.id }}">
                                    <select class="form-select form-select-sm" name="destino_disponible">
                                        <option value="">sin lugar</option>
                                        <option value="agua" {% if fila.destino_disponible == 'agua' %}selected{% endif %}>agua</option>
                                        <option value="tierra" {% if fila.destino_disponible == 'tierra' %}selected{% endif %}>tierra</option>
                                    </select>
                                    <input class="form-control form-control-sm" name="m2_disponibles" value="{{ fila.m2_disponibles }}" placeholder="m2" style="width:5rem">
                                    <select class="form-select form-select-sm" name="estado">
                                        {% for estado in ['en_lista', 'ofrecida', 'asignada', 'rechazada', 'cancelada'] %}
                                            <option value="{{ estado }}" {% if fila.estado == estado %}selected{% endif %}>{{ estado }}</option>
                                        {% endfor %}
                                    </select>
                                    <button class="btn btn-sm btn-outline-primary" type="submit">Ok</button>
                                </form>
                            {% else %}
                                {{ fila.estado }}
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="10" class="text-muted">No hay solicitudes.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
