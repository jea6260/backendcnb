{% extends 'base.html.twig' %}

{% block layout %}guest{% endblock %}

{% block title %}Ingreso · Club Náutico Bariloche{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <h1 class="h3 mb-3">Ingreso al panel</h1>
            {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endif %}
            <form method="post" action="{{ path('admin_login') }}" class="card shadow-sm">
                <div class="card-body d-grid gap-3">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <div>
                        <label class="form-label" for="username">Mail</label>
                        <input class="form-control" id="username" name="username" type="text" autocomplete="username" required value="{{ username }}">
                    </div>
                    <div>
                        <label class="form-label" for="password">Contraseña</label>
                        <input class="form-control" id="password" name="password" type="password" autocomplete="current-password" required>
                    </div>
                    <button class="btn btn-primary" type="submit">Entrar</button>
                    <div class="d-flex justify-content-between">
                        <a href="{{ path('admin_registro') }}">Crear usuario</a>
                        <a href="{{ path('admin_recuperar') }}">Recuperar contraseña</a>
                    </div>
                    <p class="text-muted small mb-0">Crear usuario es solo para socios. El personal entra con la cuenta que le da administración u operaciones. Esa cuenta sirve en la web y en la app.</p>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
