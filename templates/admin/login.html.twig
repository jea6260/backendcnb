{% extends 'base.html.twig' %}

{% block title %}Ingreso · Club Náutico Bariloche{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <h1 class="h3 mb-3">Ingreso al panel</h1>
            <p class="text-muted">Usuario y contraseña para operar el club.</p>
            {% if not configured %}
                <p class="text-muted small">Definí <code>ADMIN_USERNAME</code> y <code>ADMIN_PASSWORD</code> para habilitar el ingreso.</p>
            {% endif %}
            {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endif %}
            <form method="post" action="{{ path('admin_login') }}" class="card shadow-sm">
                <div class="card-body d-grid gap-3">
                    <div>
                        <label class="form-label" for="username">Usuario</label>
                        <input
                            class="form-control"
                            id="username"
                            name="username"
                            type="text"
                            autocomplete="username"
                            required
                            value="{{ username }}"
                        >
                    </div>
                    <div>
                        <label class="form-label" for="password">Contraseña</label>
                        <input
                            class="form-control"
                            id="password"
                            name="password"
                            type="password"
                            autocomplete="current-password"
                            required
                        >
                    </div>
                    <button class="btn btn-primary" type="submit">Entrar</button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
