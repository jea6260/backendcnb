{% extends 'base.html.twig' %}

{% block title %}Timbre · CNB{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <img src="/images/cnb_logo.jpeg" alt="Club Náutico Bariloche" width="72" height="72">
                    <h1 class="h4 mt-3">Timbre</h1>
                    <p class="text-muted">Socio #{{ numero }}</p>
                    {% if aviso == 'enviado' %}
                        <div class="alert alert-success">Pedido enviado. El timbre suena en la sede en unos segundos.</div>
                    {% elseif aviso == 'espera' %}
                        <div class="alert alert-warning">Ya hay un timbre en camino.</div>
                    {% elseif aviso == 'error' %}
                        <div class="alert alert-danger">No se pudo enviar el pedido.</div>
                    {% endif %}
                    <form method="post">
                        <button class="btn btn-primary btn-lg w-100" type="submit">Timbre</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
