<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Club Náutico Bariloche{% endblock %}</title>
        <link rel="icon" type="image/jpeg" href="/images/cnb_logo.jpeg">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="/css/cnb.css" rel="stylesheet">
        {% block stylesheets %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        <header class="cnb-header mb-4">
            <div class="container-fluid d-flex align-items-center justify-content-between gap-3">
                <a class="cnb-brand" href="{{ path(app.session.get('cnb_admin_username') ? 'admin_dashboard' : 'admin_login') }}">
                    <img
                        class="cnb-brand-logo"
                        src="/images/cnb_logo.jpeg"
                        alt="Club Náutico Bariloche"
                        width="51"
                        height="72"
                    >
                    <span>
                        <span class="cnb-brand-title">Club Náutico Bariloche</span>
                        <span class="cnb-brand-sub">operaciones</span>
                    </span>
                </a>
                <nav class="nav align-items-center">
                    {% if app.session.get('cnb_admin_username') %}
                        <a class="nav-link" href="{{ path('admin_dashboard') }}">Admin</a>
                        <a class="nav-link" href="{{ path('admin_nivel_lago') }}">Nivel del lago</a>
                        <a class="nav-link" href="{{ path('admin_varadero') }}">Varadero</a>
                        <a class="nav-link" href="/api/health">API</a>
                        <form method="post" action="{{ path('admin_logout') }}" class="d-flex align-items-center gap-2 ms-2 mb-0">
                            <span class="nav-link py-0">{{ app.session.get('cnb_admin_username') }}</span>
                            <button class="btn btn-outline-primary btn-sm" type="submit">Salir</button>
                        </form>
                    {% endif %}
                </nav>
            </div>
        </header>
        <main class="container-fluid pb-5">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
        {% block javascripts %}
        {% endblock %}
    </body>
</html>
