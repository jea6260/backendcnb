{% extends 'base.html.twig' %}

{% block title %}Socio · CNB{% endblock %}

{% block body %}
    <header class="mb-4 d-flex align-items-center gap-3">
        <img class="cnb-perfil-foto" src="{{ path('admin_perfil_foto') }}" alt="Foto de perfil" width="96" height="128" onerror="this.remove()">
        <div>
        <h1 class="h3 mb-1">Hola{% if nombre %}, {{ nombre }}{% endif %}</h1>
        {% if numero %}
            <p class="text-muted mb-2">Socio {{ numero }}</p>
        {% endif %}
        <p class="text-muted mb-0">Ves tus datos y podés completar lo que falta. Lo que ya está cargado no se cambia ni se borra desde acá.</p>
        </div>
    </header>
    <div class="row g-3">
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">Mis datos</h2>
                    <p class="text-muted">Completá el teléfono, el mail, el documento o la foto si faltan.</p>
                    <a class="btn btn-primary mt-auto" href="{{ path('admin_mis_datos') }}">Ver mis datos</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">Nivel del lago</h2>
                    <p class="text-muted">Última semana, mes o año.</p>
                    <a class="btn btn-primary mt-auto" href="{{ path('admin_nivel_lago') }}">Ver nivel</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">Timbre marineros</h2>
                    <p class="text-muted">Suena en la sede en menos de 15 segundos.</p>
                    <a class="btn btn-primary mt-auto" href="{{ path('admin_timbre') }}">Tocar timbre</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">Amarra</h2>
                    <p class="text-muted">Solicitud para comprar o alquilar, en tierra o en agua.</p>
                    <a class="btn btn-primary mt-auto" href="{{ path('admin_amarras') }}">Solicitar amarra</a>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body d-flex flex-column">
                    <h2 class="h5">Varadero</h2>
                    <p class="text-muted">Pedís el turno. El operador lo confirma y el marinero avisa la entrada y la vuelta a la amarra. Son 15 días por año, si hay lugar.</p>
                    <a class="btn btn-primary mt-auto" href="{{ path('admin_varadero') }}">Solicitar varadero</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
