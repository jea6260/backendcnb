{% extends 'base.html.twig' %}

{% block title %}Crear usuario · CNB{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-5">
            <h1 class="h3 mb-3">Crear usuario de socio</h1>
            {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endif %}

            {% if alta %}
                <form method="post" class="card shadow-sm mb-3">
                    <div class="card-body d-grid gap-3">
                        <p class="mb-0">Socio #{{ alta.numero }}{% if alta.nombre %}, {{ alta.nombre }}{% endif %}. El acceso al panel es un mail y una contraseña.</p>
                        {% if alta.cambiar %}
                            <p class="mb-0">El PIN 1234 es el de fábrica. Elegí otro antes de crear el usuario.</p>
                        {% endif %}
                        <input type="hidden" name="_token" value="{{ token }}">
                        <input type="hidden" name="accion" value="cuenta">
                        {% if alta.cambiar %}
                            <div>
                                <label class="form-label" for="pin-nuevo">PIN nuevo</label>
                                <input class="form-control" id="pin-nuevo" name="pinNuevo" type="password" inputmode="numeric" pattern="[0-9]{1,6}" maxlength="6" required>
                            </div>
                            <div>
                                <label class="form-label" for="pin-confirmar">Repetir PIN</label>
                                <input class="form-control" id="pin-confirmar" name="pinConfirmar" type="password" inputmode="numeric" pattern="[0-9]{1,6}" maxlength="6" required>
                            </div>
                        {% endif %}
                        <div>
                            <label class="form-label" for="email">Mail</label>
                            <input class="form-control" id="email" name="email" type="email" required value="{{ email }}">
                        </div>
                        <div>
                            <label class="form-label" for="password">Contraseña (mínimo 8)</label>
                            <input class="form-control" id="password" name="password" type="password" minlength="8" required>
                        </div>
                        <div>
                            <label class="form-label" for="confirmar">Repetir contraseña</label>
                            <input class="form-control" id="confirmar" name="confirmar" type="password" minlength="8" required>
                        </div>
                        <button class="btn btn-primary" type="submit">Crear usuario</button>
                    </div>
                </form>
                <form method="post">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <input type="hidden" name="accion" value="cancelar">
                    <button class="btn btn-link px-0" type="submit">Volver</button>
                </form>
            {% else %}
                <form method="post" class="card shadow-sm">
                    <div class="card-body d-grid gap-3">
                        <p class="text-muted mb-0">Solo socios. Entrá con tu número y el PIN del timbre. Si el PIN es 1234, lo cambiás en el paso siguiente y elegís mail y contraseña. El personal del club no se anota acá.</p>
                        <input type="hidden" name="_token" value="{{ token }}">
                        <input type="hidden" name="accion" value="pin">
                        <div>
                            <label class="form-label" for="numero">Número de socio</label>
                            <input class="form-control" id="numero" name="numeroSocio" inputmode="numeric" required value="{{ numero }}">
                        </div>
                        <div>
                            <label class="form-label" for="pin">PIN</label>
                            <input class="form-control" id="pin" name="pin" type="password" inputmode="numeric" pattern="[0-9]{1,6}" maxlength="6" required>
                        </div>
                        <button class="btn btn-primary" type="submit">Continuar</button>
                    </div>
                </form>
            {% endif %}
            <a class="small d-inline-block mt-3" href="{{ path('admin_login') }}">Ya tengo usuario</a>
        </div>
    </div>
{% endblock %}
